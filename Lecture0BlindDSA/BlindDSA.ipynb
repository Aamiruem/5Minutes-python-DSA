   "source": [
    "def twoSum(nums, target):\n",
    "    seen = {}\n",
    "    for i, n in enumerate(nums):\n",
    "        if target - n in seen:\n",
    "            return [seen[target-n], i]\n",
    "        seen[n] = i\n",
    "\n",
    "        \n",
    "numbers = [2, 7, 11, 15]\n",
    "target = 9\n",
    "print(twoSum(numbers, target)\n"
   ]
